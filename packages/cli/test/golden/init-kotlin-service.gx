// Drafted by `gauntlet init` from the jvm pack defaults and this repository's layout.
// Read every block before committing it: this file decides what agents' changes must pass.
gauntlet "kotlin-service"
use jvm
mode shadow // report only, never block. Switch to enforce once `gauntlet report shadow` looks right.
owners @platform

protect {
  tests  "src/test/**"
  config "*.gradle.kts", "gradle/**"
}

// Zones mark code that needs its owners' review, and scope stricter rules to it.
// Inferred from folder names: payments, billing and money code.
zone money {
  paths "src/main/kotlin/svc/settlement/**"
  owner @platform
  rule kotlin.no-floating-money
}

// Inferred from folder names: domain is the inner layer, so it never imports the outer ones.
arch { module domain must not depend on infra }

suites {
  unit "src/test/**"
}

// Ratchets keep each file from getting worse; the floors apply to new and changed lines only, so old code doesn't block a change.
gates {
  fast   { build, lint ratchet, arch }
  verify { unit, coverage ratchet >= 80% on changed, mutation ratchet >= 60% on changed }
}

predicate small = diff < 150 lines and no zone touched

review {
  owner  when zone touched
  review when protected changed
  review when dependency added
  auto   when small and all gates pass
}
