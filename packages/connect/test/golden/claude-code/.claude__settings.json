{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v gauntlet >/dev/null 2>&1; then exec gauntlet hook stop; fi; echo \"Gauntlet isn't installed on this machine, so this work wasn't checked. Install it with: curl -fsSL https://raw.githubusercontent.com/matthewjones372/gauntlet/main/install.sh | sh\" >&2; exit 1",
            "statusMessage": "Gauntlet is checking the change (build, tests, coverage)…",
            "timeout": 1800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v gauntlet >/dev/null 2>&1 || exit 0; exec gauntlet hook pre-tool-use"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__gauntlet__check",
      "mcp__gauntlet__explain",
      "mcp__gauntlet__get_examples",
      "mcp__gauntlet__get_grammar",
      "mcp__gauntlet__validate"
    ],
    "deny": [
      "Edit(*.gradle.kts)",
      "Edit(.gauntlet/**)",
      "Edit(gradle/**)",
      "Edit(settings.gradle.kts)",
      "MultiEdit(*.gradle.kts)",
      "MultiEdit(.gauntlet/**)",
      "MultiEdit(gradle/**)",
      "MultiEdit(settings.gradle.kts)",
      "NotebookEdit(*.gradle.kts)",
      "NotebookEdit(.gauntlet/**)",
      "NotebookEdit(gradle/**)",
      "NotebookEdit(settings.gradle.kts)",
      "Write(*.gradle.kts)",
      "Write(.gauntlet/**)",
      "Write(gradle/**)",
      "Write(settings.gradle.kts)"
    ]
  }
}
