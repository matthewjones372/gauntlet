diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 51502b9..aa789d9 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -156,7 +156,8 @@ jobs:
         include:
           - { target: linux-x64, os: ubuntu-latest }
           - { target: darwin-arm64, os: macos-latest }
-          - { target: darwin-x64, os: macos-latest, rosetta: true }
+          # GitHub's Intel macOS runner (until August 2027), not Rosetta on Apple Silicon.
+          - { target: darwin-x64, os: macos-15-intel }
     runs-on: ${{ matrix.os }}
