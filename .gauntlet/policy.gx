// Gauntlet's own policy. Enforced since M14: Gauntlet judges its own pull requests.
gauntlet "gauntlet"
use typescript
mode enforce
owners @matthewjones372

protect {
  tests    "packages/*/test/**", "packs/*/test/**"
  fixtures "examples/**"
  config   ".github/**"
}

// The decision itself: what nominates a tier, and what counts as evidence.
zone decision {
  paths "packages/core/src/review.ts", "packages/core/src/integrity.ts", "packages/core/src/gate-runner.ts",
        "packages/core/src/github-status.ts", "packages/author/src/loosening.ts", "packages/author/src/validate.ts",
        "packages/dsl/src/**", "packages/ir/src/**"
  owner @matthewjones372
}

// Lower layers never import higher ones.
arch {
  module ir must not depend on dsl, core, sarif, cli
  module dsl must not depend on core, cli
  module sarif must not depend on core, dsl, cli
  module core must not depend on cli, mcp, author
  module author must not depend on cli, mcp
  module mcp must not depend on cli
}

suites {
  unit  "packages/*/test/**"
  packs "packs/*/test/**"
}

// Gauntlet's own speed (scripts/bench.ts): what runs on every check, CI build and
// agent command. About five times what a laptop measures, so a slower CI machine
// passes and a change that makes Gauntlet many times slower doesn't.
budget startup {
  command "bun scripts/bench.ts startup {json}"
  p95 < 1s
}
budget hook {
  command "bun scripts/bench.ts hook {json}"
  p95 < 1s
}
budget needsbuild {
  command "bun scripts/bench.ts needs-build {json}"
  p95 < 1500ms
}
budget overhead {
  command "bun scripts/bench.ts check {json}"
  p95 < 3s
}

gates {
  fast   { build, arch }
  verify { unit, packs, coverage >= 80% on changed }
  perf   { budget startup, budget hook, budget needsbuild, budget overhead }
}

predicate small = diff < 150 lines and no zone touched

review {
  owner  when zone touched
  review when protected changed
  review when dependency added
  auto   when small and all gates pass
}
